.coverage
htmlcov/
coverage.xml

# ─── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# ─── Logs and temp ─────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
